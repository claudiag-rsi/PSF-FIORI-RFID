<mvc:View controllerName="fw.flexwarehouse.controller.Print"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">
    
    <Page id="pagPrint" class="titlePage" title="{i18n>viewNamePrint}">
        <VBox id="vbxHeadersPrint" class="header">            
            <VBox id="tlbHeaderPrint" class="headerTitle">
                <Label id="lblTitlePrint" class="title" text="{i18n>titlePrint}"></Label>
            </VBox>

            <VBox id="vbxbotonAdd" class="headerbuttons">
                <Button id="btnAddPrint" text="{i18n>newPrinting}" class="btnAccept" icon="sap-icon://add" press="onOpenDialog"/>
            </VBox>
        </VBox>    
      
        <VBox id="vbxFiltersPrint" class="filters">
            <VBox id="vbxProductFilterPrint" class="equalWidth pdRight-10">
                <Label id="lblProductFilterPrint" text="{i18n>firstFilterParameter}" class="customLabel"/>
                <Input id="inpProductFilterPrint" placeholder="{i18n>firstFilterParameter}" class="customInput"/>
            </VBox>
            
            <VBox id="vbxStartdateFilterPrint" class="equalWidth pdRight-10">
                <Label id="lblStartdateFilterPrint" text="{i18n>secondFilterParameter}" class="customLabel"/>
                <DatePicker displayFormat="dd-MM-yyyy" valueFormat="dd-MM-yyyy" id="inpStartDateFilterPrint" placeholder="{i18n>secondFilterParameter}" class="customInput"/>
            </VBox>

            <VBox id="vbxfinalDateFilter" class="equalWidth pdRight-10">
                <Label id="lblfinalDateFilter" text="{i18n>thirdFilterParameter}" class="customLabel"/>
                <DatePicker displayFormat="dd-MM-yyyy" valueFormat="dd-MM-yyyy" id="inpfinalDateFilterPrint" placeholder="{i18n>thirdFilterParameter}" class="customInput"/>
            </VBox>
            
            <VBox id="vbxbuttonsFiltersPrint" class="equalWidth buttonsfilterPrint">
                <VBox id="vbxbuttonFilterPrint" class="btnCenterFilters">
                    <Button id="btnFilterPrint" icon="sap-icon://filter" text="{i18n>btnFilter}" class="btnAccept " press="onApplyFilters"/>
                </VBox>
              
                <VBox id="vbxbuttonCleanPrint" class="btnCenterFilters">
                    <Button id="btnCleanPrint" icon="sap-icon://clear-filter" text="{i18n>btnCleanFilters}" class="btnAccept "  press="onClearFilters"/>
                </VBox>
            </VBox>
        </VBox>

        <Table class="p_2rem" id="tblPrint" items="{LabelPrintModel>/LabelPrintSet}">
            <columns>
                <Column id="colPrintLabelPrintDocDate"><Text id="txtPrintLabelPrintDocDate" text="{i18n>dateDocumentColumn}"/></Column>
                <Column id="colPrintProductCode"><Text id="txtPrintProductCode" text="{i18n>productCodeColumn}"/></Column>               
                <Column id="colPrintCenter"><Text id="txtPrintCenter" text="{i18n>centerColumn}"/></Column>
                <Column id="colPrintProductionLine"><Text id="txtPrintProductionLine" text="{i18n>productionLineColumn}"/></Column>
                <Column id="colPrintQuantityPallets"><Text id="txtPrintQuantityPallets" text="{i18n>quantityPalletsColumn}"/></Column>
                <Column id="colPrintBoxesNumber"><Text id="txtPrintBoxesNumber" text="{i18n>boxesNumberColumn}"/></Column>              
                <Column id="colReaderEmbilted"><Text id="txtReaderEmbilted" text="{i18n>embiltedColumn}"/></Column>
                <Column id="colEditPrint"><Text id="txtPrintEdit" text="Detalle"/></Column>
            </columns> 

            <items>
                <ColumnListItem id="colListItemPrint">
                    <cells>                 
                        <Text id="txtPrintValueDocDate" text="{ path: 'LabelPrintModel>Docdate', formatter: '.formatDate.formatDateToString' }"/>
                        <Text id="txtPrintValueProductcode" text="{LabelPrintModel>Productcode}"/>                         
                        <Text id="txtPrintValueCenter" text="{LabelPrintModel>Location}"/>
                        <Text id="txtPrintValueProductionLine" text="{LabelPrintModel>Productionline}"/>
                        <Text id="txtPrintValueQuantityPallets" text="{LabelPrintModel>Quantitypallets}"/>
                        <Text id="txtPrintValueBoxesNumber" text="{LabelPrintModel>Boxesnumber}"/> 
                        <Text id="txtPrintValueEmbilted" text="{LabelPrintModel>Embilstado}"/>                           
                        <Button id="btnEditPrint" icon="sap-icon://show" press="onOpenDialog" type="Accept"/>                    
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>