<Dialog
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    title="{i18n>modalNamePrint}"
    id="PrintDialog"
    stretchOnPhone="true"
    class="customDialog customFont"
>
    <content>
        <VBox
            id="vBoxMainPrint"
            class="sapUiSmallMargin customVBoxPrint"
            width="100%"
        >
            <!-- Código de Producto* -->
            <VBox id="vBoxProductCode">
                <Label
                    id="lblProductCode"
                    text="{i18n>productCodeColumn}*"
                    class="customLabel customFont"
                />
                <ComboBox
                    id="cbxProductCode"
                    class="customInput customSelect customFont"
                    selectedKey="{ProductModel>/Productcode}"
                    change="onProductChange"
                    showSecondaryValues="true"
                    filterSecondaryValues="true"
                    items="{ path: 'ProductModel>/' }"
                >
                    <core:ListItem
                        id="colProductCode"
                        key="{ProductModel>Matnr}"
                        text="{ProductModel>Description}"
                    />
                </ComboBox>
            </VBox>

            <!-- Linea de Producción* -->
            <VBox id="vBoxProductionLines">
                <Label
                    id="lblProductionLine"
                    text="{i18n>productionLineColumn}*"
                    class="customLabel customFont"
                />

                <ComboBox
                    id="cbxProductionLines"
                    class="customInput customSelect customFont"
                    selectedKey="{ProductionLineModel>/selectedKey}"
                    change="onProductChange"
                    showSecondaryValues="true"
                    filterSecondaryValues="true"
                    items="{ path: 'ProductionLineModel>/' }"
                >
                    <core:ListItem
                        id="colProductionLines"
                        key="{ProductionLineModel>Arbpl}"
                        text="{ProductionLineModel>Description}"
                    />
                </ComboBox>
            </VBox>

            <!-- Producto* -->
            <VBox
                class="full-width-second-row"
                id="vBoxProduct"
            >
                <Label
                    id="lblProduct"
                    text="{i18n>productColumn}*"
                    class="customLabel customFont"
                />
                <Text
                    id="txtProduct"
                    text="ProductModel>/Product"
                    class="customInput customText-noDrop customFont"
                />
            </VBox>

            <!-- Centro* -->
            <VBox id="vBoxCenter">
                <Label
                    id="lblCenter"
                    text="{i18n>centerColumn}*"
                    class="customLabel customFont"
                />
                <ComboBox
                    id="cbxCenters"
                    class="customInput customSelect customFont"
                    selectedKey="{centersModel>/selectedKey}"
                    showSecondaryValues="true"
                    filterSecondaryValues="true"
                    change="onProductChange"
                    items="{ path: 'centersModel>/' }"
                >
                    <core:ListItem
                        id="colCenters"
                        key="{centersModel>Werks}"
                        text="{centersModel>Description}"
                    />
                </ComboBox>
            </VBox>

            <!--Cantidad de Pallets* -->
            <VBox id="vBoxQuantityPallets">
                <Label
                    id="lblQuantityPallets"
                    text="{i18n>quantityPalletsColumn}*"
                    class="customLabel customFont"
                />
                <Input
                    id="inpQuantityPallets"
                    placeholder="{i18n>quantityPalletsColumn}"
                    class="customInput customFont"
                />
            </VBox>

            <!--Cantidad de cajas* -->
            <VBox id="vBoxBoxesNumber">
                <Label
                    id="lblBoxesNumber"
                    text="{i18n>boxesNumberColumn}*"
                    class="customLabel customFont"
                />
                <Input
                    id="inpBoxesNumber"
                    placeholder="{i18n>boxesNumberColumn}"
                    type="Number"
                    change="onValueChange"
                    class="customInput customFont"
                />
            </VBox>

            <!-- Emblistado -->
            <VBox
                id="vBoxEmbilted"
                class="row4"
            >
                <Label
                    id="lblEmbilted"
                    text="{i18n>embiltedColumn}"
                    class="customLabel customFont"
                />
                <Input
                    id="inpEmbilted"
                    placeholder="{i18n>embiltedColumn}"
                    class="customInput customFont"
                />
            </VBox>

            <!--Fecha Impresión -->
            <VBox id="vBoxPrintDate" visible="false">
                <Label
                    id="lblPrintDate"
                    text="{i18n>PrintDateColumn}"
                    class="customLabel customFont"
                />
                <Input
                    id="inpPrintDate"
                    placeholder="{i18n>PrintDateColumn}"
                    class="customInput customFont"
                />
            </VBox>
        </VBox>
    </content>

    <beginButton>
        <Button
            id="btnAcceptPrint"
            text="{i18n>save}"
            press=".onSave"
            type="Accept"
            class="btnDialogAccept"
        />
    </beginButton>

    <endButton>
        <Button
            id="btnClosePrint"
            text="{i18n>close}"
            press=".onCancel"
            type="Reject"
            class="btnDialogCancel"
        />
    </endButton>
</Dialog>
